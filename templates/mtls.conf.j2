# Managed by Ansible – 1C mTLS‑protected sites
{% for site in angie_mtls_sites %}
server {
    listen 80;
    server_name {{ site.domain }};

    location /.well-known/acme-challenge/ {
        root /var/lib/angie/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ site.domain }};

{% if site.server_extra_directives is defined %}
{%   for line in site.server_extra_directives %}
    {{ line }}
{%   endfor %}
{% endif %}

{% if angie_enable_acme and (site.ssl_cert is not defined) %}
    acme le;
    ssl_certificate     $acme_cert_le;
    ssl_certificate_key $acme_cert_key_le;
{% else %}
    ssl_certificate     {{ site.ssl_cert }};
    ssl_certificate_key {{ site.ssl_key }};
{% endif %}

    ssl_client_certificate {{ angie_clients_ca_dest }};
    ssl_crl                {{ angie_clients_crl_dest }};
    ssl_verify_client      on;
    ssl_verify_depth       2;

    ssl_session_cache      shared:SSL:10m;
    ssl_session_timeout    10m;

    access_log /var/log/angie/{{ site.domain }}.access.log;
    error_log  /var/log/angie/{{ site.domain }}.error.log;

{# ---- simple 301/302 redirects ---- #}
{% if site.simple_redirects is defined %}
{%   for r in site.simple_redirects %}
    location = {{ r.from }} {
        return {{ r.code | default(301) }} {{ r.to }};
    }

{%   endfor %}
{% endif %}
{# ---- end of simple redirects ---- #}
{% if site.locations is defined %}
{% for loc in site.locations %}
    location {{ loc.path }} {
        proxy_pass {{ loc.proxy_pass }};
        proxy_http_version 1.1;
        proxy_set_header   Host                {{ loc.host_header | default('$host') }};
        proxy_set_header   X-Forwarded-Proto   https;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-SSL-Client-Verify $ssl_client_verify;
        proxy_set_header   X-SSL-Client-DN     $ssl_client_s_dn;

{% if loc.extra_directives is defined %}
{%   for line in loc.extra_directives %}
        {{ line }}
{%   endfor %}
{% endif %}
    }

{% endfor %}

    location / {
        proxy_pass {{ site.backend }};
        proxy_http_version 1.1;
        proxy_set_header   Host                {{ site.host_header | default('$host') }};
        proxy_set_header   X-Forwarded-Proto   https;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-SSL-Client-Verify $ssl_client_verify;
        proxy_set_header   X-SSL-Client-DN     $ssl_client_s_dn;

{% if site.root_extra_directives is defined %}
{%   for line in site.root_extra_directives %}
        {{ line }}
{%   endfor %}
{% endif %}
    }

{% else %}
    location / {
        proxy_pass {{ site.backend }};
        proxy_http_version 1.1;
        proxy_set_header   Host                {{ site.host_header | default('$host') }};
        proxy_set_header   X-Forwarded-Proto   https;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-SSL-Client-Verify $ssl_client_verify;
        proxy_set_header   X-SSL-Client-DN     $ssl_client_s_dn;

{% if site.root_extra_directives is defined %}
{%   for line in site.root_extra_directives %}
        {{ line }}
{%   endfor %}
{% endif %}
    }
{% endif %}
}
{% endfor %}
