# Managed by Ansible – mTLS-protected HTML5 RDS sites

# --- WebSocket (HTTP 1.1 Upgrade) ---
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

{% for site in angie_rds_sites %}
# ---------- HTTP → HTTPS(443) redirect ----------
server {
    listen 80;
    server_name {{ site.domain }};

    # ACME-challenge
    location /.well-known/acme-challenge/ {
        root /var/lib/angie/acme;
    }

    location / {
        return 301 https://$host:{{ site.listen_port | default(443) }}$request_uri;
    }
}

# ---------- HTTPS / mTLS on {{ site.listen_port | default(443) }} ----------
server {
    listen {{ site.listen_port | default(443) }} ssl;
    http2 on;
    access_log /var/log/angie/{{ site.domain }}.access.log;
    error_log  /var/log/angie/{{ site.domain }}.error.log;
    server_name {{ site.domain }};

{% if angie_enable_acme and (site.ssl_cert is not defined) %}
    acme le;
    ssl_certificate     $acme_cert_le;
    ssl_certificate_key $acme_cert_key_le;
{% else %}
    ssl_certificate     {{ site.ssl_cert }};
    ssl_certificate_key {{ site.ssl_key }};
{% endif %}

    ssl_client_certificate {{ angie_clients_ca_dest }};
    ssl_crl               {{ angie_clients_crl_dest }};
    ssl_verify_client on;
    ssl_verify_depth 2;

    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    location = / {
        return 301 /RDWeb/webclient/;
    }

    location / {
        proxy_pass https://{{ site.backend_host }}:{{ site.backend_port | default(443) }}/;
        proxy_http_version 1.1;

        proxy_ssl_server_name on;
        proxy_ssl_verify      off;

        # WebSocket-заголовки
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host                $host;
        proxy_set_header X-Forwarded-Proto   https;
        proxy_set_header X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
        proxy_set_header X-SSL-Client-DN     $ssl_client_s_dn;

        proxy_read_timeout {{ site.timeouts.read  | default('3600s') }};
        proxy_send_timeout {{ site.timeouts.send  | default('3600s') }};
{% if site.proxy_buffering is defined and not site.proxy_buffering %}
        proxy_buffering off;
{% endif %}
    }

    add_header Content-Security-Policy "default-src * data: 'unsafe-eval' 'unsafe-inline'; img-src * data: blob:; media-src * data: blob:" always;
}
{% endfor %}
