# Managed by Ansible – additional plain‑HTTP reverse proxies

{% for srv in angie_extra_servers_acme %}
server {
    listen {{ srv.listen | default(80) }};
    server_name {{ srv.server_name }};

    location /.well-known/acme-challenge/ {
        proxy_pass {{ srv.proxy_pass }}.well-known/acme-challenge/;
{% if srv.add_host_header | default(true) %}
        proxy_set_header Host $host;
{% endif %}
{% if srv.add_real_ip_header | default(true) %}
        proxy_set_header X-Real-IP $remote_addr;
{% endif %}
    }

    location / {
        return 403;
    }
}
{% endfor %}
