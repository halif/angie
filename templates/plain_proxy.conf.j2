# Managed by Ansible - plain TLS reverse-proxy sites (without mTLS)
{% for site in angie_plain_proxy_sites %}
server {
    listen 80;
    server_name {{ site.domain }};

    location /.well-known/acme-challenge/ {
        root /var/lib/angie/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ site.domain }};

{% if angie_enable_acme and (site.ssl_cert is not defined) %}
    acme le;
    ssl_certificate     $acme_cert_le;
    ssl_certificate_key $acme_cert_key_le;
{% else %}
    ssl_certificate     {{ site.ssl_cert }};
    ssl_certificate_key {{ site.ssl_key }};
{% endif %}

    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    access_log /var/log/angie/{{ site.domain }}.access.log;
    error_log  /var/log/angie/{{ site.domain }}.error.log;

{% if site.locations is defined %}
{% for loc in site.locations %}
    location {{ loc.path }} {
        proxy_pass {{ loc.proxy_pass | default(site.backend) }};
        proxy_http_version 1.1;
        proxy_set_header   Host              {{ loc.host_header | default(site.host_header | default('$host')) }};
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout {{ loc.proxy_read_timeout | default(site.proxy_read_timeout | default('3600s')) }};
        proxy_send_timeout {{ loc.proxy_send_timeout | default(site.proxy_send_timeout | default('3600s')) }};
        proxy_buffering    {{ loc.proxy_buffering | default(site.proxy_buffering | default('off')) }};
{% if loc.extra_directives is defined %}
{%   for line in loc.extra_directives %}
        {{ line }}
{%   endfor %}
{% endif %}
    }

{% endfor %}
{% endif %}

    location / {
{% if site.deny_unmatched | default(false) %}
        return 403;
{% else %}
        proxy_pass {{ site.backend }};
        proxy_http_version 1.1;
        proxy_set_header   Host              {{ site.host_header | default('$host') }};
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout {{ site.proxy_read_timeout | default('3600s') }};
        proxy_send_timeout {{ site.proxy_send_timeout | default('3600s') }};
        proxy_buffering    off;
{% if site.root_extra_directives is defined %}
{%   for line in site.root_extra_directives %}
        {{ line }}
{%   endfor %}
{% endif %}
{% endif %}
    }

{% if site.enable_standalone_signaling | default(true) %}
    location /standalone-signaling/ {
        proxy_pass {{ site.backend }};
        proxy_http_version 1.1;
        proxy_set_header   Host              {{ site.host_header | default('$host') }};
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout {{ site.proxy_read_timeout | default('3600s') }};
        proxy_send_timeout {{ site.proxy_send_timeout | default('3600s') }};
        proxy_buffering    off;
    }

    location /standalone-signaling/spreed  {
        proxy_pass {{ site.backend }}spreed;
        proxy_http_version 1.1;
        proxy_set_header   Host              {{ site.host_header | default('$host') }};
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_read_timeout {{ site.proxy_read_timeout | default('3600s') }};
        proxy_send_timeout {{ site.proxy_send_timeout | default('3600s') }};
        proxy_buffering    off;
    }
{% endif %}
}
{% endfor %}
